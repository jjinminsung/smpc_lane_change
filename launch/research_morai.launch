<launch>
  <!-- research/tree-planner MORAI 실험. 대회 스택(behavior 끔) 위에 SMPC 층을 GT 인지로 얹는다.
       total_bringup 은 고치지 않는다.
         기존 SMPC:  roslaunch smpc_lane_change research_morai.launch method:=baseline
         트리:       roslaunch smpc_lane_change research_morai.launch method:=tree
         트리+게이트 정리: ... method:=tree tree_keep_gates:=false
       2×2 (모두 게이트 정리):
         A 기존 판단 + rear_abort:  method:=baseline baseline_keep_gates:=false
         B 기존 판단 + 트리 모니터: method:=baseline baseline_keep_gates:=false monitor:=true
         C 트리 판단 + rear_abort:  method:=tree tree_keep_gates:=false monitor:=false
         D 트리 판단 + 트리 모니터: method:=tree tree_keep_gates:=false              -->
  <arg name="method" default="baseline"/>              <!-- baseline | tree -->
  <arg name="tree_keep_gates" default="true"/>
  <arg name="baseline_keep_gates" default="true"/>
  <!-- 차선 변경 중 트리 모니터로 rear_abort 를 대체할지. 기본: 트리 판단일 때만 -->
  <arg name="monitor" default="$(eval arg('method') == 'tree')"/>
  <arg name="rear_accel_table" default="gt"/>          <!-- 두 방법 모두 같은 GT 표로 비교 -->
  <arg name="target_source" default="object_topic"/>   <!-- GT 인지. 라이다 비교는 tracked_objects -->
  <arg name="sim_ip" default="192.168.100.10"/>        <!-- 집 PC: lo 별칭. 대회 PC: 192.168.0.1 -->
  <arg name="path_number" default="0"/>
  <arg name="use_rviz" default="false"/>
  <arg name="dry_run" default="false"/>

  <include file="$(find total_bringup)/launch/competition.launch">
    <arg name="sim_ip" value="$(arg sim_ip)"/>
    <arg name="enable_behavior" value="false"/>
    <arg name="path_number" value="$(arg path_number)"/>
    <arg name="use_rviz" value="$(arg use_rviz)"/>
    <arg name="dry_run" value="$(arg dry_run)"/>
  </include>

  <!-- GT 인지: MORAI Object Info UDP(7605→7505) → /Object_topic. 이 노드가 이미 UTM 오프셋과
       heading 보정(-1.347 deg)을 적용하므로 target_selector 의 같은 보정은 아래에서 0 으로 둔다.
       후륜축 → 박스 중심 보정(object_topic_ref_to_center_m)은 그대로 쓴다. -->
  <include file="$(find morai_udp_bridge)/launch/morai_object_info.launch"/>

  <include file="$(find smpc_lane_change)/launch/smpc_integration.launch">
    <arg name="use_rviz" value="false"/>
    <arg name="use_lidar_tracker" value="false"/>
    <arg name="target_source" value="$(arg target_source)"/>
    <arg name="tree_planner_enabled" value="$(eval arg('method') == 'tree')"/>
    <arg name="tree_keep_gates" value="$(arg tree_keep_gates)"/>
    <arg name="tree_monitor_enabled" value="$(arg monitor)"/>
    <arg name="tree_abort_enabled" value="$(arg monitor)"/>
    <arg name="baseline_keep_gates" value="$(arg baseline_keep_gates)"/>
    <arg name="baseline_tree_monitor" value="$(eval arg('monitor') and arg('method') == 'baseline')"/>
    <arg name="rear_accel_table" value="$(arg rear_accel_table)"/>
  </include>
  <param name="/smpc_target_selector/object_topic_offset_x" value="0.0"/>
  <param name="/smpc_target_selector/object_topic_offset_y" value="0.0"/>
  <param name="/smpc_target_selector/object_topic_heading_offset_deg" value="0.0"/>
</launch>
